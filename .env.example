# Sitenin genel adresi — canonical, sitemap ve robots.txt bu degeri kullanir.
NEXT_PUBLIC_SITE_URL=https://www.teminatrapor.com

# Dosya on inceleme basvurularinin iletilecegi webhook adresi.
# Tanimli degilse basvurular yalnizca sunucu gunlugune yazilir.
# CRM, e-posta servisi (Resend/SendGrid) veya otomasyon araci (Zapier/Make) baglanabilir.
PRE_REVIEW_WEBHOOK_URL=

# Webhook istegine Authorization: Bearer <token> basligi eklenir (istege bagli).
PRE_REVIEW_WEBHOOK_TOKEN=
